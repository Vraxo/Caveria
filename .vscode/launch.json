{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play Caveria (Desktop)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}\\node_modules\\.bin\\electron.cmd"
      },
      "runtimeArgs": ["."],
      "preLaunchTask": "caveria: build",
      "console": "integratedTerminal",
      "outputCapture": "std"
    },
    {
      "name": "Play Caveria (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "caveria: dev-server"
    },
    {
      "name": "Play Caveria (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "caveria: dev-server"
    }
  ]
}
